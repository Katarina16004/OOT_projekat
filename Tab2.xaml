<UserControl x:Class="projekat.Tab2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:projekat"
             mc:Ignorable="d" >
    <Grid Background="White" Margin="5" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="auto"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- SEARCH BAR - 2x2 Grid -->
        <Grid Margin="50 5 50 0" Visibility="Visible" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="3*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <TextBlock Grid.Column="0" Margin="3 0" HorizontalAlignment="Right" VerticalAlignment="Center" Height="25">Pretrazite:</TextBlock>
            <Border Grid.Column="1" VerticalAlignment="Center" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Height="25">
                <TextBox Margin="10 0" VerticalAlignment="Center" x:Name="SearchBar"  Background="Transparent" BorderBrush="Transparent" TextChanged="SearchBar_TextChanged" AcceptsReturn="False" AcceptsTab="False"></TextBox>
            </Border>

        </Grid>

        <!-- Main content - 1x2 Grid -->
        <Grid Margin="5 0" Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition MinWidth="350" Width="16*"/>
                <ColumnDefinition Width="159*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- Friend list - TreeView -->
            <TreeView x:Name="friendList" HorizontalContentAlignment="Stretch">
                <!-- Popunjava se u Tab2.xaml.cs konstruktoru -->
                <TreeView.ItemTemplate>
                    <DataTemplate>
                        <TreeViewItem MouseLeftButtonUp="HandleMouseClick" FontSize="13" Margin="0 3" HorizontalContentAlignment="Stretch" Tag="{Binding Id}">
                            <TreeViewItem.Header>
                                <DockPanel>
                                    <Image Source="{Binding Profilna_slika}" Width="30" Margin="3">
                                    </Image>
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="Ime" />
                                                <Binding Path="Prezime" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DockPanel>
                            </TreeViewItem.Header>
                            <Button Tag="{Binding Id}" Margin="3" FontSize="10" MouseDoubleClick="UkloniPrijatelja">
                                <DockPanel>
                                    <Image Margin="3 0" Source="fajlovi/image/remove-user.png" Width="13"></Image>
                                    <TextBlock Margin="3">Obrisi prijatelja</TextBlock>
                                </DockPanel>
                            </Button>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <ScrollViewer Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="2">
                <StackPanel>
                    <!-- Search results - ListView -->
                    <ListView Grid.Row="0" Grid.Column="1" Margin="10" Name="SearchResult" SelectionMode="Single" Visibility="Collapsed" HorizontalContentAlignment="Stretch">

                        <!-- Popunjava se rezultatima pretrage -->

                    </ListView>

                    <!-- Profile preview - StackPanel -->

                    <StackPanel x:Name="profilePreview" Margin="10"  Visibility="Visible">
                        <!-- Profile image -->
                        <Ellipse Width="100" Height="100">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Profilna_slika}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- User's name and id - 2x1 Grid -->
                        <!-- Row 1: first and last name -->
                        <!-- Row 2: id -->
                        <Grid Margin="10 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"></RowDefinition>
                                <RowDefinition Height="0.5*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <!-- First and last name -->
                            <DockPanel HorizontalAlignment="Center">
                                <TextBlock Name="imeprikaz" HorizontalAlignment="Right" Margin="5" FontWeight="Bold" FontSize="30" Text="{Binding Ime}"></TextBlock>
                                <TextBlock Name="prezimeprikaz" HorizontalAlignment="Left" FontWeight="Bold" FontSize="30" Margin="5" Text="{Binding Prezime}"></TextBlock>
                            </DockPanel>

                            <!-- ID -->
                            <DockPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock >Id:</TextBlock>
                                <TextBlock Name="id"  Text="{Binding Id}"></TextBlock>
                            </DockPanel>

                        </Grid>

                        <!-- Users's information: date of birth, number of posts, and number of friends - 1x3 Grid -->
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Margin" Value="10 0" />
                                </Style>
                            </Grid.Resources>

                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="Gray">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center">Datum rodjenja:</TextBlock>
                                    <TextBlock HorizontalAlignment="Center" Name="datum" Text="{Binding Datum_rodjenja}"></TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" CornerRadius="10" BorderThickness="1" BorderBrush="Gray">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center">Objave:</TextBlock>
                                    <TextBlock HorizontalAlignment="Center" Name="objave" Text="{Binding ObjaveCount}"></TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" CornerRadius="10" BorderThickness="1" BorderBrush="Gray">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center">Prijatelji:</TextBlock>
                                    <TextBlock HorizontalAlignment="Center" Text="{Binding PrijateljiCount}"></TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ListView Name="PostListView" ItemsSource="{Binding Postovi}" HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="5">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding Datum_objave}" Margin="2"></TextBlock>
                                            <DockPanel VerticalAlignment="Center" Margin="5 3" HorizontalAlignment="Right">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Lajkovi}" Margin="3 1"></TextBlock>
                                                <Image VerticalAlignment="Center" Source="fajlovi/image/like.png" Width="20"/>
                                            </DockPanel>
                                        </DockPanel>

                                        <WrapPanel Tag="{Binding Id_posta}">
                                            <TextBlock Text="#" Foreground="Gray" Margin="2 2 0 2"/>
                                            <TextBlock Text="{Binding Id_posta}" Foreground="Gray" Margin="0 2 0 2"/>
                                            <TextBlock Text=":" Foreground="Gray" Margin="0 2 2 2"/>
                                            <TextBlock Text="{Binding Sadrzaj}" Margin="2"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
