<UserControl x:Class="projekat.Tab3"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:projekat"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <Grid Background="White">
        <ScrollViewer>
            <StackPanel Margin="20">
                <TextBlock FontWeight="Bold" FontSize="14">Spisak grupa u kojima se nalazite:</TextBlock>
                <ListView Name="listagrupa" ItemsSource="{Binding Grupe}" SelectionChanged="listagrupa_SelectionChanged" Height="340">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="ID: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Id_grupe}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Naziv: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Ime_grupe}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Opis: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Opis_grupe}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Broj članova: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Clanovi.Count}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Margin="5">
                    <Grid.ColumnDefinitions >
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Button Name="dodajgrupu" Margin="2,2,2,2" MouseDoubleClick="dodajgrupu_MouseLeftButtonUp">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF9FE8D3" Offset="0"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background> Dodaj grupu</Button>
                    <Button Name="obrisigrupu" IsEnabled="False" Grid.Column="1" Margin="2" MouseDoubleClick="obrisigrupu_MouseDoubleClick">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF9FE8D3" Offset="0"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background> Obrisi grupu</Button>
                    <Button Name="izmenigrupu" IsEnabled="False" Grid.Column="2" Margin="2" MouseDoubleClick="izmenigrupu_MouseDoubleClick">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF9FE8D3" Offset="0"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background> Uredi grupu</Button>
                </Grid>
                <TextBlock x:Name="txtdisk" Background="#FF9FE8D3" FontSize="15" FontWeight="Bold" Margin="15" Visibility="Hidden">Diskusije izabrane grupe: </TextBlock>
                <ListView Name="listadisk" Visibility="Hidden" Height="220" Margin="5" ItemsSource="{Binding Diskusije}" SelectionChanged="listadisk_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Blue" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Naziv diskusije: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Naziv_diskusije}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Datum poslednje poslate poruke: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Datumporuke}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Broj clanova: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Broj_clanova_diskusije}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Grid Name="uredjivanje_diskusija" Visibility="Hidden">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>
                    <Button Name="dodajdiskusiju" Margin="2" Click="dodajdiskusiju_Click">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF9FE8D3" Offset="0"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background> Dodaj diskusiju</Button>
                    <Button Name="obrisidiskusiju" IsEnabled="False" Grid.Column="1" Margin="2" Click="obrisidiskusiju_Click">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF9FE8D3" Offset="0"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background> Obrisi diskusiju</Button>
                    <Button Name="izmenidiskusiju" IsEnabled="False" Grid.Column="2" Margin="2" Click="izmenidiskusiju_Click">
                        <Button.Background>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF9FE8D3" Offset="0"/>
                                <GradientStop Color="White" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background> Uredi diskusiju</Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
